# opencode portable env — machine-local values for THIS machine.
# install.sh generates env.sh from this template. Edit placeholders, then open a new shell.
export OPENCODE_BIN_DIRS="/PATH/TO/NODEJS/bin:/PATH/TO/USER/BIN"   # REQUIRED — local MCP servers prepend this to PATH
export VOLTRA_ROOT="/PATH/TO/VOLTRA"                                # optional — filesystem MCP root
export ARDUINO_SKETCH_ROOT="$VOLTRA_ROOT/firmware"                  # optional — arduino MCP root (defaults under VOLTRA_ROOT)
# GitHub MCP alternative: export GITHUB_PERSONAL_ACCESS_TOKEN="..."  (or use .secrets/github-pat file)