{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "default_agent": "OpenAgent",
  "subagent_depth": 2,
  "plugin": [
    "opencode-skills-collection@latest",
    "oh-my-opencode-slim",
    "./plugins/claude-mem.js"
  ],
  "agent": {
    "build": {
      "description": "The default agent. Executes tools based on configured permissions.",
      "mode": "primary"
    },
    "plan": {
      "description": "Constructs well-formed plans before implementation.",
      "mode": "primary"
    },
    "general": {
      "description": "General-purpose subagent for multi-step tasks.",
      "mode": "subagent",
      "disable": true
    },
    "explore": {
      "description": "Fast agent for exploring codebases.",
      "mode": "subagent",
      "disable": true
    },
    "review": {
      "description": "Reviews code for issues and improvements.",
      "mode": "subagent"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/.secrets/github-pat}"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "environment": {
        "PATH": "{env:OPENCODE_BIN_DIRS}:{env:PATH}"
      },
      "enabled": true,
      "timeout": 90000
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "environment": {
        "PATH": "{env:OPENCODE_BIN_DIRS}:{env:PATH}"
      },
      "enabled": true,
      "timeout": 90000
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "{env:VOLTRA_ROOT}"
      ],
      "environment": {
        "PATH": "{env:OPENCODE_BIN_DIRS}:{env:PATH}"
      },
      "enabled": true,
      "timeout": 90000
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "environment": {
        "PATH": "{env:OPENCODE_BIN_DIRS}:{env:PATH}"
      },
      "enabled": true
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "semgrep": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.12",
        "semgrep-mcp"
      ],
      "environment": {
        "PATH": "{env:OPENCODE_BIN_DIRS}:{env:PATH}"
      },
      "enabled": false,
      "timeout": 120000
    },
    "arduino": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "arduino-mcp-server"
      ],
      "environment": {
        "PATH": "{env:OPENCODE_BIN_DIRS}:{env:PATH}",
        "ARDUINO_SKETCH_ROOT": "{env:ARDUINO_SKETCH_ROOT}"
      },
      "enabled": true,
      "timeout": 90000
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "PATH": "{env:OPENCODE_BIN_DIRS}:{env:PATH}"
      },
      "enabled": true,
      "timeout": 90000
    }
  }
}
