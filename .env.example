# opencode portable env example
# opencode resolves {env:VAR} from the process environment only —
# there is no auto-loading of config-dir .env files.
# Machine-local values are loaded from ~/.config/opencode/env.sh
# (sourced from ~/.bashrc via the guarded line below); the installer
# generates env.sh from this template on setup, so this file NEVER
# contains machine-specific paths.

# Machine-local bin directories, added to local MCP servers' PATH.
# e.g. colon-separated: /home/you/.local/lib/nodejs/bin:/home/you/.local/bin
export OPENCODE_BIN_DIRS="/home/you/.local/lib/nodejs/bin:/home/you/.local/bin"

# Path to your project folder, mounted by the filesystem MCP server.
# On WSL this is a Windows drive path; omit if you don't use that server.
VOLTRA_ROOT=<path to your project folder, e.g. /mnt/c/Users/you/Downloads/VOLTRA>

# Arduino sketch root, typically $VOLTRA_ROOT/firmware.
# Used by the arduino MCP server to find sketch files.
# ARDUINO_SKETCH_ROOT=$VOLTRA_ROOT/firmware

# Optional Telegram bot keys — set if you use the Telegram subagent.
# TELEGRAM_BOT_TOKEN=ghp_xxx
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_BOT_USERNAME=mybot
# TELEGRAM_IDLE_TIMEOUT=300
# TELEGRAM_CHECK_INTERVAL=60
# TELEGRAM_ENABLED=true
# GEMINI_API_KEY=xxxxx
# MINIMAX_API_KEY=xxxxx